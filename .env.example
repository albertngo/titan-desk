# Variable NAMES only. Values live in GitHub Actions secrets, Vercel env, and your shell.

# --- sync worker (sync/) ---
AIRTABLE_TOKEN=                # PAT with data.records:read + schema.bases:read on the Bert base ONLY
DATABASE_URL=                  # postgresql://sync_worker.<project-ref>:<pw>@aws-0-ca-central-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=                  # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=     # used for Storage uploads only
SYNC_IMAGE_BATCH=300           # optional: images processed per --mode images run
SYNC_PURGE_DAYS=30             # optional: variant purge window

# --- web app (web/) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STORAGE_HOST=      # <project-ref>.supabase.co
GITHUB_DISPATCH_TOKEN=         # fine-grained PAT for repository_dispatch (Sync now)
GITHUB_DISPATCH_REPO=albertngo/titan-desk
SYNC_TRIGGER_SECRET=           # x-sync-secret for non-browser callers

# --- quoting app (quote/) — set in the quote Vercel project ONLY, never the desk's ---
# quote/ reuses NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY for sign-in.
QUOTE_AIRTABLE_TOKEN=          # its own PAT, Bert base only: data.records:read + data.records:write (writes reach the four quote tables only)
QUOTE_GHL_TOKEN=               # its own GHL private integration token, used read-only: contacts, opportunities, conversations + conversations/message (readonly)
QUOTE_MAKE_GHL_HOOK=           # the "Quote app -> GHL" Make webhook; set only after that scenario is switched on
QUOTE_MAKE_GHL_KEY=            # the shared key that scenario checks
QUOTE_BOOKING_KEY=             # the key Make 3453735 sends to /api/booking (x-quote-key header); unset = booking step off
QUOTE_ALLOWED_EMAILS=          # comma-separated Microsoft emails allowed to quote; empty = nobody
QUOTE_CUSTOMER_URL=            # the customer deployment's address (https://...); unset = sending quotes is off
QUOTE_COMPANY_NAME=            # letterhead on sent quotes; defaults to Titan Flooring
QUOTE_COMPANY_ADDRESS=
QUOTE_COMPANY_PHONE=
QUOTE_COMPANY_EMAIL=
QUOTE_COMPANY_WEBSITE=
QUOTE_COMPANY_HST=             # HST registration number printed on quotes
QUOTE_LOGO_URL=                # https URL of the logo for the email header and the link preview card (set on BOTH quote deployments)
QUOTE_BOOKING_URL=             # https URL of the in-store visit booking page a preliminary's email offers; unset = no button
# --- quoting app, customer deployment (a second Vercel project on quote/) — these two ONLY ---
# QUOTE_MODE=customer
# QUOTE_AIRTABLE_TOKEN=        # read-only PAT: Bert base, data.records:read

# --- askBert assistant (web/agents/askbert) ---
# askBert reuses NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY and the staff member's session.
AI_GATEWAY_API_KEY=            # local dev + GitHub Actions evals only; Vercel deployments use project OIDC

# --- local test harness (db/scripts/local-pg.sh) ---
TITAN_TEST_DB=titan_desk_test
